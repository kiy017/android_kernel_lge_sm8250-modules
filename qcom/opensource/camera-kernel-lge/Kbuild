# timelm: out-of-tree build of LG's 4.19 kona techpack/camera as one
# camera.ko (the vendor CamX camera.kona.so needs this exact uapi: the 5.15
# camera-kernel changed struct cam_control and therefore VIDIOC_CAM_CONTROL).
# The per-directory Makefiles are the stock built-in ones and are not used;
# this file lists the same objects in the stock link order.  Stock built it
# into the kernel (obj-y), so the initcalls are run by camera_main.c.

# timelm: in-tree via techpack/camera (O=out): $(src) is objtree-relative
CAM := $(srctree)/$(src)

# konacamera.conf / konacameraconf.h + the LG machine symbols.
ccflags-y += -DCONFIG_SPECTRA_CAMERA_KONA=1 -DCONFIG_SPECTRA_CAMERA=1
ccflags-y += -DCONFIG_MACH_LGE=1 -DCONFIG_MACH_KONA_TIMELM=1
# timelm: stock kona had CONFIG_MSM_GLOBAL_SYNX=y; cam_sync registers its
# synx bind ops (CamX CVP node binds synx objects to CSL fences)
ccflags-y += -DTIMELM_CAM_GLOBAL_SYNX=1
ccflags-y += -I$(srctree)/drivers/media/platform/msm/synx
CONFIG_MACH_LGE := y

cam_include_dirs := $(shell find $(CAM)/drivers -name '*.h' -printf '%h\n' | sort -u)
ccflags-y += -I$(CAM)/include/uapi -I$(CAM)/include
ccflags-y += $(addprefix -I,$(cam_include_dirs))

obj-m += camera.o

camera-y := drivers/camera_main.o
