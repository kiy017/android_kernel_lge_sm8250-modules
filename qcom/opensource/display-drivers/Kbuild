ifeq ($(DISPLAY_ROOT),)
DISPLAY_ROOT=$(srctree)/techpack/display
endif

# When built into vmlinux (not as an external module) DISPLAY_ROOT is set here
# and must reach the sub-make that reads msm/Kbuild.
export DISPLAY_ROOT

LINUXINCLUDE    += \
		   -I$(DISPLAY_ROOT)/include/uapi/display \
		   -I$(DISPLAY_ROOT)/include
USERINCLUDE     += -I$(DISPLAY_ROOT)/include/uapi/display

obj-$(CONFIG_DRM_MSM) += msm/
obj-$(CONFIG_QCOM_MDSS_PLL) += pll/
