ifneq (, $(filter y, $(CONFIG_ARCH_LAHAINA) $(CONFIG_ARCH_WAIPIO) $(CONFIG_ARCH_KALAMA) $(CONFIG_ARCH_CROW) $(CONFIG_ARCH_MONACO) $(CONFIG_ARCH_TRINKET)))
ccflags-y	+= -DRMNET_LA_PLATFORM
endif

ifeq ($(CONFIG_ARCH_KHAJE), y)
  ifeq ($(MSM_ARCH), bengal)
    ccflags-y       += -DRMNET_LA_PLATFORM
  endif
endif

ifeq ($(CONFIG_ARCH_SDXNIGHTJAR), y)
ccflags-y	+= -DRMNET_TRACE_INCLUDE_LE
endif

obj-m += rmnet_core.o

#core sources
rmnet_core-y := \
	rmnet_config.o \
	rmnet_handlers.o \
	rmnet_descriptor.o \
	rmnet_genl.o \
	rmnet_map_command.o \
	rmnet_map_data.o \
	rmnet_module.o \
	rmnet_vnd.o

rmnet_core-y += \
	rmnet_ll.o

# timelm: the SDX55 data path (and RMNET_DATA_LL, if the modem ever offers it)
# is MHI, not IPA; build with RMNET_LL_MHI=y (techpack/datarmnet/Kbuild in the kernel tree).
ifeq ($(RMNET_LL_MHI),y)
rmnet_core-y += rmnet_ll_mhi.o
else
rmnet_core-y += rmnet_ll_ipa.o
endif

# timelm: QMAP DFC needs rmnet_ctl; on kona/SDX55 it runs over the MHI
# RMNET_CTL channels (109/110), like stock 4.19 CONFIG_RMNET_CTL.
ifeq ($(RMNET_CTL_MHI),y)
ccflags-y += -DRMNET_CTL_MHI
obj-m += rmnet_ctl.o
rmnet_ctl-y := \
	rmnet_ctl_client.o \
	rmnet_ctl_mhi.o
endif

#DFC sources
rmnet_core-y += \
	qmi_rmnet.o \
	wda_qmi.o \
	dfc_qmi.o \
	dfc_qmap.o \
	rmnet_qmap.o \
	rmnet_ll_qmap.o

ifneq (, $(filter y, $(CONFIG_ARCH_LAHAINA) $(CONFIG_ARCH_WAIPIO) $(CONFIG_ARCH_KALAMA) $(CONFIG_ARCH_CROW) $(CONFIG_ARCH_MONACO) $(CONFIG_ARCH_TRINKET)))
obj-m += rmnet_ctl.o
rmnet_ctl-y := \
	rmnet_ctl_client.o \
	rmnet_ctl_ipa.o
endif

ifeq ($(CONFIG_ARCH_KHAJE), y)
  ifeq ($(MSM_ARCH), bengal)
    obj-m += rmnet_ctl.o
    rmnet_ctl-y := \
        rmnet_ctl_client.o \
        rmnet_ctl_ipa.o
  endif
endif
